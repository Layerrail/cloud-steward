APP_ENV=development
DATABASE_URL=sqlite:///./var/cloud-steward.db

# Gemini structured planning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Optional CPU-only local planning through llama.cpp's llama-completion. When
# configured, this takes precedence over Gemini and retains the same guardrails.
LLAMA_CPP_BINARY=
LLAMA_CPP_MODEL_PATH=
LLAMA_CPP_MODEL_NAME=Qwen2.5-0.5B-Instruct Q4_0
LLAMA_CPP_THREADS=4
LLAMA_CPP_CONTEXT_SIZE=4096
LLAMA_CPP_MAX_TOKENS=768
LLAMA_CPP_TIMEOUT_SECONDS=300

# Choose a managed Streamable HTTP MCP endpoint OR a self-hosted DataHub GMS URL.
DATAHUB_MCP_URL=
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
DATAHUB_SEARCH_TOOL=

# Optional future execution adapter. Mutations remain disabled by default.
LAYERRAIL_API_URL=https://api.layerrail.com
LAYERRAIL_API_TOKEN=
REQUIRE_APPROVAL=true
ALLOW_MUTATIONS=false
